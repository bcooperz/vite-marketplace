{
  "name": "vite-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace monorepo with frontend, backend, database, and shared types",
  "pnpm": {
    "workspace": {
      "packages": {
        "marketplace-backend": {
          "dependencies": [
            "@marketplace-types"
          ]
        },
        "marketplace-frontend": {
          "dependencies": [
            "@marketplace-types"
          ]
        },
        "marketplace-types": {}
      }
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "build:backend": "pnpm --filter marketplace-backend build",
    "build:frontend": "pnpm --filter marketplace build",
    "build:types": "pnpm --filter @marketplace-types tsc",
    "clean": "pnpm --recursive exec rm -rf node_modules dist",
    "install:all": "pnpm install",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive tsc"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
