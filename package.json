{
  "name": "vite-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace monorepo with frontend, backend, database, and shared types",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build:turbo": "turbo run build",
    "dev:turbo": "turbo run dev",
    "build": "pnpm --recursive build",
    "build:backend": "pnpm --filter marketplace-backend build",
    "build:frontend": "pnpm --filter marketplace-frontend build",
    "build:types": "pnpm --filter @marketplace-types tsc",
    "clean": "pnpm --recursive exec rm -rf node_modules dist",
    "install:all": "pnpm install",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive tsc",
    "migrate:latest": "pnpm --filter marketplace-database migrate:latest",
    "migrate:rollback": "pnpm --filter marketplace-database migrate:rollback",
    "migrate:make": "pnpm --filter marketplace-database migrate:make"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
